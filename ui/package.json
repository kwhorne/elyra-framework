{
  "name": "@elyra/ui",
  "version": "0.20.0",
  "description": "Elyra's desktop components for Svelte 5, and the design tokens the app and @elyra/runtime share.",
  "type": "module",
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.svelte",
    "src/**/*.css",
    "!src/**/*.test.js",
    "!src/test-setup.js",
    "!src/test/**",
    "!src/**/node_modules/**",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhorne/elyra-framework.git",
    "directory": "ui"
  },
  "homepage": "https://elyracode.com/framework",
  "keywords": [
    "elyra",
    "svelte",
    "components",
    "desktop",
    "design-tokens"
  ],
  "scripts": {
    "test": "vitest run",
    "gallery": "vite --config gallery/vite.config.js",
    "gallery:build": "vite build --config gallery/vite.config.js"
  },
  "peerDependencies": {
    "@elyra/runtime": ">=0.20.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@elyra/runtime": "file:../runtime",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "vitest": "^4.1.10"
  }
}
